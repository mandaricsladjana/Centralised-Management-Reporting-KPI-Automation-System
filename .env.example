# =============================================================================
# Centralised Manufacturing Quality KPI Reporting System: environment template
# Copy to .env and fill in the values.  NEVER commit .env.
# Python loads .env with override=True, so values here win over shell variables.
# =============================================================================

# --- Environment selector -----------------------------------------------------
ENVIRONMENT=dev                      # dev = local SQL Express, prod = Azure SQL

# --- Local DEV database (Windows authentication) ------------------------------
LOCAL_SQL_SERVER=.\SQLEXPRESS
LOCAL_SQL_DATABASE=QualityKPI_Dev

# --- Azure SQL (PROD) ---------------------------------------------------------
AZURE_SQL_SERVER=<server-name>.database.windows.net
AZURE_SQL_DATABASE=QualityKPI
AZURE_SQL_AUTH=entra                 # entra = az login token (people), sql = SQL login (scheduler)

# Scheduled ETL login (created in Phase 7). Used only when AZURE_SQL_AUTH=sql.
AZURE_SQL_USERNAME=etl_loader
AZURE_SQL_PASSWORD=

# Break-glass server admin. Never used by the pipeline.
AZURE_SQL_ADMIN_USERNAME=kpiadmin
AZURE_SQL_ADMIN_PASSWORD=

# --- Azure Blob Storage -------------------------------------------------------
AZURE_STORAGE_ACCOUNT=azurestoragecentralkpi
# Connection string (contains the account key). DEV only; optional once Entra RBAC is used.
AZURE_STORAGE_CONNECTION_STRING=

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
