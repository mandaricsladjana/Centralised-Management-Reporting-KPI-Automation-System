// Evaluates [KPI Cards HTML] in 7 filter contexts. Run: powerbi/tools/run_dax.ps1
DEFINE
MEASURE 'KPI Targets'[KPI Cards HTML Test] =
// Executive KPI cards with targets as one HTML Content Secure visual. Presentation only: every number,
// status, target and trend comes from the existing measures. Generated by powerbi/tools/build_kpi_cards.mjs.
VAR _hasData = NOT ISBLANK ( [Production Volume] )
// order, label, value, value text, status, target label, change label, trend, bar low, bar high, target
VAR _kpis =
    {
        ( 1, "FTY", [FTY %], FORMAT ( [FTY %], "0.00%" ), [FTY % Status], [FTY % Target Label], [FTY % Change Label], [FTY % Trend], 0.9, 1, [FTY % Target] ),
        ( 2, "Defect rate", [Defect Rate %], FORMAT ( [Defect Rate %], "0.00%" ), [Defect Rate % Status], [Defect Rate % Target Label], [Defect Rate % Change Label], [Defect Rate % Trend], 0, 2 * [Defect Rate % Target], [Defect Rate % Target] ),
        ( 3, "Scrap rate", [Scrap Rate %], FORMAT ( [Scrap Rate %], "0.00%" ), [Scrap Rate % Status], [Scrap Rate % Target Label], [Scrap Rate % Change Label], [Scrap Rate % Trend], 0, 2 * [Scrap Rate % Target], [Scrap Rate % Target] ),
        ( 4, "Rework rate", [Rework Rate %], FORMAT ( [Rework Rate %], "0.00%" ), [Rework Rate % Status], [Rework Rate % Target Label], [Rework Rate % Change Label], [Rework Rate % Trend], 0, 2 * [Rework Rate % Target], [Rework Rate % Target] ),
        ( 5, "COPQ %", [COPQ %], FORMAT ( [COPQ %], "0.00%" ), [COPQ % Status], [COPQ % Target Label], [COPQ % Change Label], [COPQ % Trend], 0, 2 * [COPQ % Target], [COPQ % Target] ),
        ( 6, "Overdue 8Ds", COALESCE ( [Overdue 8Ds], 0 ), FORMAT ( COALESCE ( [Overdue 8Ds], 0 ), "0" ), [Overdue 8Ds Status], [Overdue 8Ds Target Label], [Overdue 8Ds Change Label], [Overdue 8Ds Trend], 0, MAX ( 6, COALESCE ( [Overdue 8Ds], 0 ) ), [Overdue 8Ds Target] )
    }
VAR _tiles =
    CONCATENATEX (
        _kpis,
        VAR _value = [Value3]
        VAR _status = [Value5]
        VAR _change = [Value7]
        VAR _trend = [Value8]
        VAR _low = [Value9]
        VAR _span = [Value10] - [Value9]
        VAR _color = SWITCH ( _status, "Green", "#2E7D32", "Amber", "#B26A00", "Red", "#C62828", "#6B7280" )
        VAR _tint = SWITCH ( _status, "Green", "#E8F5E9", "Amber", "#FFF3E0", "Red", "#FDECEA", "#F3F4F6" )
        VAR _pill = SWITCH ( _status, "Green", "On target", "Amber", "Near target", "Red", "Off target", "No data" )
        VAR _trendColor = SWITCH ( _trend, "Improving", "#2E7D32", "Worsening", "#C62828", "#6B7280" )
        VAR _trendTint = SWITCH ( _trend, "Improving", "#E8F5E9", "Worsening", "#FDECEA", "#F3F4F6" )
        VAR _valueText = IF ( ISBLANK ( _value ), "–", [Value4] )
        VAR _targetText = SUBSTITUTE ( [Value6], "Target ", "" )
        // bar: share of the KPI scale covered by the value, and where the target sits (whole percent, 0-100)
        VAR _fill = IF ( ISBLANK ( _value ) || _span <= 0, 0, INT ( ROUND ( MAX ( 0, MIN ( 1, DIVIDE ( _value - _low, _span ) ) ) * 100, 0 ) ) )
        VAR _tick = IF ( _span <= 0, 0, MIN ( 99, INT ( ROUND ( MAX ( 0, MIN ( 1, DIVIDE ( [Value11] - _low, _span ) ) ) * 100, 0 ) ) ) )
        VAR _changeHtml =
            IF (
                ISBLANK ( _change ),
                "<span>No previous month to compare</span>",
                "<span style='font-weight:700;padding:2px 8px;border-radius:999px;background:" & _trendTint & ";color:" & _trendColor & "'>" & SUBSTITUTE ( _change, " vs prev. month", "" ) & "</span><span>" & IF ( CONTAINSSTRING ( _change, " vs prev. month" ), "vs prev. month", "" ) & "</span>"
            )
        RETURN
            "<div style='flex:1 1 172px;min-width:0;box-sizing:border-box;background:#FFFFFF;border:1px solid #E5E7EB;border-top:3px solid " & _color & ";border-radius:8px;padding:10px 12px 11px'>" & "<div style='display:flex;justify-content:space-between;align-items:center;gap:6px'>" & "<span style='font-size:12px;font-weight:600;color:#374151;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & [Value2] & "</span>" & "<span style='flex:none;font-size:10px;font-weight:600;padding:2px 8px;border-radius:999px;background:" & _tint & ";color:" & _color & "'>" & _pill & "</span></div>" & "<div style='display:flex;justify-content:space-between;align-items:flex-end;margin-top:8px'>" & "<div><div style='" & "font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:#6B7280;" & "'>Now</div><div style='font-size:27px;font-weight:700;line-height:1.1;color:" & _color & "'>" & _valueText & "</div></div>" & "<div style='text-align:right'><div style='" & "font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:#6B7280;" & "'>Target</div><div style='font-size:15px;font-weight:600;line-height:1.5;color:#1F2937'>" & _targetText & "</div></div></div>" & "<div style='position:relative;height:6px;margin:9px 0 9px;background:#EEF0F3;border-radius:3px'>" & "<div style='width:" & _fill & "%;height:6px;border-radius:3px;background:" & _color & "'></div>" & "<div style='position:absolute;top:-4px;left:" & _tick & "%;width:2px;height:14px;background:#111827'></div></div>" & "<div style='display:flex;align-items:center;gap:6px;font-size:11px;color:#6B7280'>" & _changeHtml & "</div></div>",
        "",
        [Value1], ASC
    )
RETURN
    IF ( _hasData, "<div style='display:flex;flex-wrap:wrap;gap:10px;font-family:Segoe UI,Arial,sans-serif;'>" & _tiles & "</div>", "<div style='font-family:Segoe UI,Arial,sans-serif;padding:26px 12px;text-align:center;font-size:13px;color:#6B7280;background:#FFFFFF;border:1px dashed #D1D5DB;border-radius:8px'>No data for the selected period and filters</div>" )
EVALUATE
UNION (
    ROW ( "Order", 1, "Case", "October 2026 · all programs (default view of the page)", "Html", CALCULATE ( [KPI Cards HTML Test], 'Calendar'[Year Month] = "2026-10" ) ),
    ROW ( "Order", 2, "Case", "September 2025 · EV launch month", "Html", CALCULATE ( [KPI Cards HTML Test], 'Calendar'[Year Month] = "2025-09" ) ),
    ROW ( "Order", 3, "Case", "November 2024 · first month of data (no previous month)", "Html", CALCULATE ( [KPI Cards HTML Test], 'Calendar'[Year Month] = "2024-11" ) ),
    ROW ( "Order", 4, "Case", "October 2026 · vehicle program VP-EV-D only", "Html", CALCULATE ( [KPI Cards HTML Test], 'Calendar'[Year Month] = "2026-10", 'Part'[Program Code] = "VP-EV-D" ) ),
    ROW ( "Order", 5, "Case", "October 2026 · VP-HATCH-B only (ended June 2026): empty state", "Html", CALCULATE ( [KPI Cards HTML Test], 'Calendar'[Year Month] = "2026-10", 'Part'[Program Code] = "VP-HATCH-B" ) ),
    ROW ( "Order", 6, "Case", "March 2027 · month without data: empty state", "Html", CALCULATE ( [KPI Cards HTML Test], 'Calendar'[Year Month] = "2027-03" ) ),
    ROW ( "Order", 7, "Case", "No month selected · whole history", "Html", [KPI Cards HTML Test] )
)
ORDER BY [Order]
