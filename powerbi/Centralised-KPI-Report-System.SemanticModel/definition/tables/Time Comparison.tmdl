table 'Time Comparison'
	lineageTag: 9594d5fd-f53d-4939-98da-6ff2839ca0e8

	/// Applies a time comparison to any KPI measure (blueprint 7: Δ vs previous month on page 1; MoM, YoY and rolling 3 months on page 7). Delta items only work on numeric measures.
	calculationGroup
		precedence: 10

		/// The KPI for the selected period.
		calculationItem Current = SELECTEDMEASURE ()

		/// The KPI for the same period shifted back one month.
		calculationItem 'Previous Month' = CALCULATE ( SELECTEDMEASURE (), DATEADD ( 'Calendar'[Date], -1, MONTH ) )

		/// Current minus previous month, in the KPI's own unit (percentage points for % KPIs).
		calculationItem 'Change vs Previous Month' =
				VAR _current = SELECTEDMEASURE ()
				VAR _previous = CALCULATE ( SELECTEDMEASURE (), DATEADD ( 'Calendar'[Date], -1, MONTH ) )
				RETURN IF ( ISNUMBER ( _current ) && ISNUMBER ( _previous ), _current - _previous )

			formatStringDefinition =
					VAR _f = SELECTEDMEASUREFORMATSTRING ()
					RETURN "+" & _f & ";-" & _f & ";" & _f

		/// The KPI for the same period one year earlier.
		calculationItem 'Previous Year' = CALCULATE ( SELECTEDMEASURE (), SAMEPERIODLASTYEAR ( 'Calendar'[Date] ) )

		/// Current minus the same period last year, in the KPI's own unit.
		calculationItem 'Change vs Previous Year' =
				VAR _current = SELECTEDMEASURE ()
				VAR _previous = CALCULATE ( SELECTEDMEASURE (), SAMEPERIODLASTYEAR ( 'Calendar'[Date] ) )
				RETURN IF ( ISNUMBER ( _current ) && ISNUMBER ( _previous ), _current - _previous )

			formatStringDefinition =
					VAR _f = SELECTEDMEASUREFORMATSTRING ()
					RETURN "+" & _f & ";-" & _f & ";" & _f

		/// The KPI recalculated over the 3 months ending with the selected period (ratio of sums, not an average of monthly rates).
		calculationItem 'Rolling 3 Months' = CALCULATE ( SELECTEDMEASURE (), DATESINPERIOD ( 'Calendar'[Date], MAX ( 'Calendar'[Date] ), -3, MONTH ) )

	column 'Time Comparison'
		dataType: string
		lineageTag: 624b8f9b-faa8-423e-bcd5-9f7b4e39ed90

	partition 'Partition_Time Comparison' = calculationGroup

