	/// Internal, Customer complaint or Audit.
	column 'Problem Source'
		dataType: string
		lineageTag: ec6d8835-c554-4dd3-9244-4e852d7e07d4
		summarizeBy: none
		sourceColumn: problem_source

	/// Responsible engineer (fictional).
	column Owner
		dataType: string
		lineageTag: 0cdd7b36-27e0-4475-ae5d-e634e54805f4
		summarizeBy: none
		sourceColumn: owner_name

	column 'Owner Department'
