	/// D2: problem described.
	column 'D2 Problem'
		dataType: dateTime
		formatString: yyyy-mm-dd
		displayFolder: Milestones
		lineageTag: 08932568-ee19-4675-8ead-c6fdb74513c2
		summarizeBy: none
		sourceColumn: d2_date

	/// D3: containment in place.
	column 'D3 Containment'
		dataType: dateTime
		formatString: yyyy-mm-dd
		displayFolder: Milestones
		lineageTag: 667c00bb-c426-4521-900f-52d8b6c693cf
		summarizeBy: none
		sourceColumn: d3_date

	/// D4: root cause found.
	column 'D4 Root Cause'
		dataType: dateTime
