/// One row per 8D problem-solving report (rpt.v_fact_8d). Status is derived from the D8 date, not from the free-text status (blueprint 5.5). Active calendar relationship: opened date.
table '8D Reports'
	lineageTag: 78f39c61-bfe6-4e08-b850-6caed321dca9

	/// 8D reports opened in the selected period (active relationship: opened date).
	measure '# 8Ds Opened' = COUNTROWS ( '8D Reports' )
		formatString: #,##0
		displayFolder: Flow
		lineageTag: f1e05520-1281-46f4-a8e2-3e35b80f810a

	/// 8Ds opened in the period whose part and defect type had another 8D closed in the 180 days before (D23).
	measure '# Repeat 8Ds' = CALCULATE ( COUNTROWS ( '8D Reports' ), KEEPFILTERS ( '8D Reports'[Is Repeat] = TRUE () ) )
		formatString: #,##0
		displayFolder: Flow
		lineageTag: f9af1137-e652-4d40-a3c8-501e7bca4797

	/// Repeat 8Ds / 8Ds opened in the period. Measures the effectiveness of past fixes. Target <= 5 %.
	measure 'Repeat Defect Rate %' = DIVIDE ( [# Repeat 8Ds], [# 8Ds Opened] )
		formatString: 0.0%
		displayFolder: Flow
		lineageTag: b8f22b2b-1850-4cfb-8520-85e5a23dc58c

	/// 8D reports closed (D8 date) in the selected period.
	measure '# 8Ds Closed' = CALCULATE ( COUNTROWS ( '8D Reports' ), USERELATIONSHIP ( '8D Reports'[Closed Date Key], 'Calendar'[Date Key] ) )
		formatString: #,##0
		displayFolder: Closure
		lineageTag: 3e68ec68-6311-455f-b360-292915187da1

	/// Average days from opening to D8 for 8Ds closed in the period. Target <= 60 days.
	measure 'Avg 8D Closure Days' = CALCULATE ( AVERAGE ( '8D Reports'[Days To Close] ), USERELATIONSHIP ( '8D Reports'[Closed Date Key], 'Calendar'[Date Key] ) )
		formatString: #,##0.0
		displayFolder: Closure
		lineageTag: 7c697d1a-c68b-4e9e-ba85-1877019fca6c

	/// 8Ds closed on or before their target date / 8Ds closed in the period. Target >= 90 %.
	measure '8D On-time Closure %' =
			CALCULATE (
			    DIVIDE (
			        CALCULATE ( COUNTROWS ( '8D Reports' ), KEEPFILTERS ( '8D Reports'[Is Closed On Time] = TRUE () ) ),
			        COUNTROWS ( '8D Reports' )
			    ),
			    USERELATIONSHIP ( '8D Reports'[Closed Date Key], 'Calendar'[Date Key] )
			)
		formatString: 0.0%
		displayFolder: Closure
		lineageTag: d84a7d83-ac33-4d25-b6bb-87610fbc2407

	/// 8D reports whose target closure date falls in the selected period.
	measure '# 8Ds Due' = CALCULATE ( COUNTROWS ( '8D Reports' ), USERELATIONSHIP ( '8D Reports'[Target Closure Date Key], 'Calendar'[Date Key] ) )
		formatString: #,##0
		displayFolder: Closure
		lineageTag: 859639bf-f467-4e45-ab46-388df9a55cb6

	/// 8Ds open at the end of the selected period (or today for the current period). Snapshot: do not sum over months.
	measure 'Open 8Ds' =
			VAR _asOf = MIN ( MAX ( 'Calendar'[Date] ), TODAY () )
			RETURN
			    CALCULATE (
			        COUNTROWS ( '8D Reports' ),
			        REMOVEFILTERS ( 'Calendar' ),
			        '8D Reports'[Opened Date] <= _asOf,
			        FILTER ( ALL ( '8D Reports'[Closed Date] ), ISBLANK ( '8D Reports'[Closed Date] ) || '8D Reports'[Closed Date] > _asOf )
			    )
		formatString: #,##0
		displayFolder: Snapshot
		lineageTag: 9cd17ac3-b8f5-4ef6-bb49-b41bc52e040f

	/// Open 8Ds past their target closure date at the end of the selected period. Target 0.
	measure 'Overdue 8Ds' =
			VAR _asOf = MIN ( MAX ( 'Calendar'[Date] ), TODAY () )
			RETURN
			    CALCULATE (
			        COUNTROWS ( '8D Reports' ),
			        REMOVEFILTERS ( 'Calendar' ),
			        '8D Reports'[Opened Date] <= _asOf,
			        '8D Reports'[Target Closure Date] < _asOf,
			        FILTER ( ALL ( '8D Reports'[Closed Date] ), ISBLANK ( '8D Reports'[Closed Date] ) || '8D Reports'[Closed Date] > _asOf )
			    )
		formatString: #,##0
		displayFolder: Snapshot
		lineageTag: aec56e48-d6fb-4dcb-bc6e-78aaae906bf5

	/// Nonconformities investigated by the 8D reports in the filter context (inactive relationship, D9).
	measure '# Linked NCs' =
			CALCULATE (
			    COUNTROWS ( 'Nonconformities' ),
			    USERELATIONSHIP ( 'Nonconformities'[8D Key], '8D Reports'[8D Key] ),
			    CROSSFILTER ( 'Nonconformities'[Date Key], 'Calendar'[Date Key], NONE )
			)
		formatString: #,##0
		displayFolder: Links
		lineageTag: 3df3dbac-2d88-4d50-867a-288cbe3bcfe7

	/// Audit findings that led to the 8D reports in the filter context (inactive relationship, D9).
	measure '# Linked Audit Findings' =
			CALCULATE (
			    COUNTROWS ( 'Audit Findings' ),
			    USERELATIONSHIP ( 'Audit Findings'[8D Key], '8D Reports'[8D Key] ),
			    CROSSFILTER ( 'Audit Findings'[Audit Date Key], 'Calendar'[Date Key], NONE ),
			    CROSSFILTER ( 'Audit Findings'[Line Key], 'Production Line'[Line Key], NONE )
			)
		formatString: #,##0
		displayFolder: Links
		lineageTag: 7027b3ee-7f8f-4343-8071-8d9ecf77cbc4

	column '8D Key'
		dataType: int64
		isHidden
		lineageTag: 28639e19-e56d-48d1-a8c5-7211dc2b91fb
		summarizeBy: none
		sourceColumn: eight_d_key

	/// 8D report ID, 8D-YYYY-###.
	column '8D ID'
		dataType: string
		lineageTag: b09864db-9d60-4665-8fe3-9485fb7dabe6
		summarizeBy: none
		sourceColumn: eight_d_id

	column 'Opened Date Key'
