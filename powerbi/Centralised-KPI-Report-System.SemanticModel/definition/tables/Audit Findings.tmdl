		summarizeBy: none
		sourceColumn: audit_type

	/// Clause reference, e.g. IATF 16949 8.5.1 (no standard text reproduced).
	column 'Standard Reference'
		dataType: string
		lineageTag: 0f66235b-b66d-4408-9510-27416c575694
		summarizeBy: none
		sourceColumn: standard_reference

	column 'Line Key'
		dataType: int64
		isHidden
		lineageTag: e5d0d49b-f782-44db-8e19-56c477890208
		summarizeBy: none
		sourceColumn: line_key

	/// Major NC, Minor NC, Observation or OFI (Opportunity For Improvement).
	column Classification
		dataType: string
		lineageTag: 1e3834f1-4365-4aa5-bbd4-1eb552e0ca6b
		summarizeBy: none
		sourceColumn: classification
		sortByColumn: 'Classification Sort'

	column Finding
		dataType: string
		lineageTag: 81aac74a-c335-476d-82be-f8b6f84a5cef
		summarizeBy: none
		sourceColumn: finding_description

	column 'Finding Owner'
