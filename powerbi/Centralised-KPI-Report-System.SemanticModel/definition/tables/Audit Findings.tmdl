	partition 'Audit Findings' = m
		mode: import
		source =
				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    Data = Source{[Schema = "rpt", Item = "v_fact_audit_finding"]}[Data]
				in
				    Data

