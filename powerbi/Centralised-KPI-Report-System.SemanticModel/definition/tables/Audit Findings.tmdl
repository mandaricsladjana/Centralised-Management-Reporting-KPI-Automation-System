/// One row per audit finding (rpt.v_fact_audit_finding). Line N/A = plant-wide finding. Active calendar relationship: audit date.
table 'Audit Findings'
	lineageTag: f4dcad06-1ba3-49a6-8863-4f5d12fa8f99

	/// Audit findings raised in the selected period (active relationship: audit date).
	measure '# Findings Raised' = COUNTROWS ( 'Audit Findings' )
		formatString: #,##0
		displayFolder: Findings
		lineageTag: 95da98c5-00b8-4f71-ac16-ce222f7d3792

	/// Major nonconformities raised in audits in the period. Target 0.
	measure 'Major NCs' = CALCULATE ( COUNTROWS ( 'Audit Findings' ), KEEPFILTERS ( 'Audit Findings'[Classification] = "Major NC" ) )
		formatString: #,##0
		displayFolder: Findings
		lineageTag: fea4eb40-098d-4d97-99ce-81533baae2a6

	/// Audit findings closed in the selected period.
	measure '# Findings Closed' = CALCULATE ( COUNTROWS ( 'Audit Findings' ), USERELATIONSHIP ( 'Audit Findings'[Closed Date Key], 'Calendar'[Date Key] ) )
		formatString: #,##0
		displayFolder: Closure
		lineageTag: ac836ba6-4bb2-4d42-a28f-b7756205eaa9

	/// Average days from audit to closure for findings closed in the period. Target <= 30 days.
	measure 'Avg Finding Closure Days' = CALCULATE ( AVERAGE ( 'Audit Findings'[Finding Days To Close] ), USERELATIONSHIP ( 'Audit Findings'[Closed Date Key], 'Calendar'[Date Key] ) )
		formatString: #,##0.0
		displayFolder: Closure
		lineageTag: a5f9fe52-fc4b-47fe-a3b6-e5d6687735dd

	/// Findings closed on or before their due date / findings closed in the period. Target >= 90 %.
	measure 'Audit On-time Closure %' =
			CALCULATE (
			    DIVIDE (
			        CALCULATE ( COUNTROWS ( 'Audit Findings' ), KEEPFILTERS ( 'Audit Findings'[Is Finding Closed On Time] = TRUE () ) ),
			        COUNTROWS ( 'Audit Findings' )
			    ),
			    USERELATIONSHIP ( 'Audit Findings'[Closed Date Key], 'Calendar'[Date Key] )
			)
		formatString: 0.0%
		displayFolder: Closure
		lineageTag: e67b6b94-2069-4e90-ad5b-234f2c037983

	/// Audit findings due for closure in the selected period.
	measure '# Findings Due' = CALCULATE ( COUNTROWS ( 'Audit Findings' ), USERELATIONSHIP ( 'Audit Findings'[Due Date Key], 'Calendar'[Date Key] ) )
		formatString: #,##0
		displayFolder: Closure
		lineageTag: 5b533dba-1028-4515-9032-6cf663d3fd76

	/// Audit findings open at the end of the selected period (or today). Snapshot: do not sum over months.
	measure 'Open Findings' =
			VAR _asOf = MIN ( MAX ( 'Calendar'[Date] ), TODAY () )
			RETURN
			    CALCULATE (
			        COUNTROWS ( 'Audit Findings' ),
			        REMOVEFILTERS ( 'Calendar' ),
			        'Audit Findings'[Audit Date] <= _asOf,
			        FILTER ( ALL ( 'Audit Findings'[Finding Closed Date] ), ISBLANK ( 'Audit Findings'[Finding Closed Date] ) || 'Audit Findings'[Finding Closed Date] > _asOf )
			    )
		formatString: #,##0
		displayFolder: Snapshot
		lineageTag: 6cc3d59b-404f-4aa6-a365-8cd85b6358c3

	/// Open audit findings past their due date at the end of the selected period. Target 0.
	measure 'Overdue Findings' =
			VAR _asOf = MIN ( MAX ( 'Calendar'[Date] ), TODAY () )
			RETURN
			    CALCULATE (
			        COUNTROWS ( 'Audit Findings' ),
			        REMOVEFILTERS ( 'Calendar' ),
			        'Audit Findings'[Audit Date] <= _asOf,
			        'Audit Findings'[Finding Due Date] < _asOf,
			        FILTER ( ALL ( 'Audit Findings'[Finding Closed Date] ), ISBLANK ( 'Audit Findings'[Finding Closed Date] ) || 'Audit Findings'[Finding Closed Date] > _asOf )
			    )
		formatString: #,##0
		displayFolder: Snapshot
		lineageTag: 7773910f-dbf2-44c5-8a84-ce60c70e1a27

	column 'Finding Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: 0d8851a9-3ded-45d7-827e-775f92d14569
		summarizeBy: none
		sourceColumn: finding_key

	column 'Finding ID'
		dataType: string
		lineageTag: 568bf227-55de-48cb-8775-66bfb412e4a9
		summarizeBy: none
		sourceColumn: finding_id

	/// One audit produces several findings.
	column 'Audit ID'
		dataType: string
		lineageTag: ec2e4aef-9b2b-4f5d-8eb5-a58f57ab15a9
		summarizeBy: none
		sourceColumn: audit_id

	column 'Audit Date Key'
