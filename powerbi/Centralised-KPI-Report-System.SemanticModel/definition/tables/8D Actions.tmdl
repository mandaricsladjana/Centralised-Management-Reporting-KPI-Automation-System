/// Containment, corrective and preventive actions of the 8D reports (rpt.v_fact_8d_action). Filtered by the calendar through its 8D report; due and completed dates use inactive relationships.
table '8D Actions'
	lineageTag: 623edb50-378f-4178-a8f7-95e0521423b0

	/// 8D actions due in the selected period.
	measure '# Actions Due' =
			CALCULATE (
			    COUNTROWS ( '8D Actions' ),
			    USERELATIONSHIP ( '8D Actions'[Due Date Key], 'Calendar'[Date Key] ),
			    CROSSFILTER ( '8D Reports'[Opened Date Key], 'Calendar'[Date Key], NONE )
			)
		formatString: #,##0
		displayFolder: Corrective Actions
		lineageTag: a7b94f0b-a043-485f-9ec9-f575e5f02b70

	/// Actions due in the period that were completed by the end of the period (even if late).
	measure '# Actions Completed' =
			VAR _periodEnd = MAX ( 'Calendar'[Date] )
			RETURN
			    CALCULATE (
			        COUNTROWS ( '8D Actions' ),
			        USERELATIONSHIP ( '8D Actions'[Due Date Key], 'Calendar'[Date Key] ),
			        CROSSFILTER ( '8D Reports'[Opened Date Key], 'Calendar'[Date Key], NONE ),
			        KEEPFILTERS ( '8D Actions'[Completed Date] <= _periodEnd ),
			        KEEPFILTERS ( NOT ISBLANK ( '8D Actions'[Completed Date] ) )
			    )
		formatString: #,##0
		displayFolder: Corrective Actions
		lineageTag: 5e76074a-4cda-456b-9724-d45bf371a646

	/// Corrective Action completion rate: actions due in the period and completed by its end / actions due. Target >= 95 %.
	measure 'CA Completion %' = DIVIDE ( [# Actions Completed], [# Actions Due] )
		formatString: 0.0%
		displayFolder: Corrective Actions
		lineageTag: 8c4ea9b5-5dd5-4268-a0a9-d0bc22f3a087

	/// Actions completed (by completion date) in the selected period, whatever their due date.
	measure '# Actions Completed In Period' =
			CALCULATE (
			    COUNTROWS ( '8D Actions' ),
			    USERELATIONSHIP ( '8D Actions'[Completed Date Key], 'Calendar'[Date Key] ),
			    CROSSFILTER ( '8D Reports'[Opened Date Key], 'Calendar'[Date Key], NONE )
			)
		formatString: #,##0
		displayFolder: Corrective Actions
		lineageTag: 36bb0ab6-d322-4ab9-b823-6d21513cad37

	column 'Action Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: 9c8a2a38-9d60-4724-b087-884bc8d66352
		summarizeBy: none
		sourceColumn: action_key

	column 'Action ID'
