/// Centralised Manufacturing Quality KPI model (Danube Automotive Components, fictional). Import of the rpt views of the QualityKPI SQL database. KPI definitions: documentation/01_project_blueprint.md section 6 and data dictionary section 12.
model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: sr-Latn-RS
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

annotation PBI_QueryOrder = ["Calendar","Shift","Production Line","Part","Defect Type","Inspection Stage","Production","Inspections","Nonconformities","Scrap","Rework","8D Reports","8D Actions","Audit Findings","KPI Targets","SqlServer","SqlDatabase"]

ref table Calendar
ref table Shift
ref table 'Production Line'
ref table Part
ref table 'Defect Type'
ref table 'Inspection Stage'
ref table Production
ref table Inspections
ref table Nonconformities
ref table Scrap
ref table Rework
ref table '8D Reports'
ref table '8D Actions'
ref table 'Audit Findings'
ref table 'KPI Targets'
ref table 'Time Comparison'

ref cultureInfo en-US

